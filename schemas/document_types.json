      "display_name": "Loan Application",
      "vietnamese_name": "Hồ sơ đăng ký vay vốn",
      "description": "Tài liệu mô tả hồ sơ đăng ký vay vốn của khách hàng, bao gồm thông tin khoản vay, mục đích vay, thu nhập, trạng thái việc làm và trạng thái KYC.",
      "business_purpose": "Dùng để hỗ trợ nhân viên tín dụng xem xét hồ sơ vay và cung cấp context cho RAG khi người dùng hỏi về thông tin khoản vay.",
      "source_system": "loan_system",
      "source_type": "business_document",
      "original_format": "json",
      "owner_department": "credit",
      "default_sensitivity": "high",
      "default_retention_level": "standard",
      "field_policy_ref": "policy_loan_application_v1",
      "target_count_for_demo": 100,
      "document_id_prefix": "loan",
      "customer_id_required": true,
      "metadata_defaults": {
        "department": "credit",
        "document_owner": "credit_department",
        "allowed_departments": [
          "credit",
          "risk",
          "management"
        ],
        "access_tags": [
          "loan",
          "credit",
          "customer_data",
          "loan_application"
        ]
      },
      "document_level_access": {
        "full_access_roles": [
          "loan_officer",
          "risk_analyst"
        ],
        "partial_access_roles": [
          "teller",
          "compliance_officer",
          "branch_manager",
          "admin"
        ],
        "denied_roles": []
      },
      "required_content_fields": [
        "customer_name",
        "loan_amount",
        "loan_purpose",
        "income",
        "employment_status",
        "kyc_status"
      ],
      "optional_content_fields": [
        "requested_term_months",
        "collateral_type",
        "application_status",
        "credit_score",
        "risk_note"
      ],
      "content_fields": [
        {
          "field_name": "customer_name",
          "type": "string",
          "sensitivity": "medium",
          "description": "Tên khách hàng giả lập."
        },
        {
          "field_name": "loan_amount",
          "type": "number",
          "sensitivity": "high",
          "description": "Số tiền vay được khách hàng yêu cầu."
        },
        {
          "field_name": "loan_purpose",
          "type": "string",
          "sensitivity": "medium",
          "description": "Mục đích vay vốn.",
          "example_values": [
            "home renovation",
            "business expansion",
            "car purchase",
            "education fee",
            "personal expense"
          ]
        },
        {
          "field_name": "income",
          "type": "number",
          "sensitivity": "high",
          "description": "Thu nhập hằng tháng của khách hàng."
        },
        {
          "field_name": "employment_status",
          "type": "string",
          "sensitivity": "medium",
          "description": "Tình trạng việc làm của khách hàng.",
          "example_values": [
            "full_time",
            "part_time",
            "self_employed",
            "unemployed",
            "retired"
          ]
        },
        {
          "field_name": "kyc_status",
          "type": "string",
          "sensitivity": "medium",
          "description": "Trạng thái xác minh KYC của khách hàng.",
          "example_values": [
            "verified",
            "pending",
            "rejected",
            "expired"
          ]
        },
        {
          "field_name": "requested_term_months",
          "type": "number",
          "sensitivity": "medium",
          "description": "Thời hạn vay được yêu cầu, tính theo tháng."
        },
        {
          "field_name": "collateral_type",
          "type": "string",
          "sensitivity": "medium",
          "description": "Loại tài sản bảo đảm.",
          "example_values": [
            "none",
            "house",
            "car",
            "savings_account",
            "business_asset"
          ]
        },
        {
          "field_name": "application_status",
          "type": "string",
          "sensitivity": "medium",
          "description": "Trạng thái xử lý hồ sơ vay.",
          "example_values": [
            "submitted",
            "under_review",
            "approved",
            "rejected"
          ]
        },
        {
          "field_name": "credit_score",
          "type": "number",
          "sensitivity": "high",
          "description": "Điểm tín dụng nếu được đính kèm vào hồ sơ vay."
        },
        {
          "field_name": "risk_note",
          "type": "string",
          "sensitivity": "restricted",
          "description": "Ghi chú rủi ro nội bộ liên quan đến hồ sơ vay."
        }
      ],
      "embedding_text_template": "Customer {customer_id} submitted a loan application for {loan_purpose}. The requested loan amount is {loan_amount} VND. KYC status is {kyc_status} and the application status is {application_status}.",
      "example_queries": [
        "Show loan information of customer C10001",
        "What is the loan amount requested by customer C10001?",
        "What is the income of customer C10001?",
        "Show the loan application status of customer C10001"
      ]
    },
