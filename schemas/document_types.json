{
  "schema_name": "banking_secure_rag_document_types",
  "version": "1.0",
  "description": "Document type definitions for Banking Secure RAG dataset. These document types are used to generate synthetic banking documents for Vector NoSQL Database, metadata filtering, document-level access control, and field-level masking.",
  "case_study": "Banking RAG Assistant for Loan and KYC Document Retrieval",
  "document_types": [
    {
