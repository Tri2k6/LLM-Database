      "content_fields": [
        {
          "field_name": "customer_name",
          "type": "string",
          "sensitivity": "medium",
          "description": "Tên khách hàng giả lập."
        },
        {
          "field_name": "national_id_masked",
          "type": "string",
          "sensitivity": "high",
          "description": "Số định danh cá nhân đã được che một phần. Không lưu số định danh thật trong dataset."
        },
        {
          "field_name": "date_of_birth",
          "type": "string",
          "format": "YYYY-MM-DD",
          "sensitivity": "high",
          "description": "Ngày sinh của khách hàng."
        },
        {
          "field_name": "address",
          "type": "string",
          "sensitivity": "high",
          "description": "Địa chỉ của khách hàng."
        },
        {
          "field_name": "kyc_status",
          "type": "string",
          "sensitivity": "medium",
          "description": "Trạng thái xác minh KYC.",
          "example_values": [
            "verified",
            "pending",
            "rejected",
            "expired"
          ]
        },
        {
          "field_name": "phone_masked",
          "type": "string",
          "sensitivity": "medium",
          "description": "Số điện thoại đã được che một phần."
        },
        {
          "field_name": "email_masked",
          "type": "string",
          "sensitivity": "medium",
          "description": "Email đã được che một phần."
        },
        {
          "field_name": "aml_status",
          "type": "string",
          "sensitivity": "restricted",
          "description": "Trạng thái kiểm tra AML.",
          "example_values": [
            "clear",
            "under_review",
            "flagged"
          ]
        },
        {
          "field_name": "last_verified_at",
          "type": "string",
          "format": "YYYY-MM-DD",
          "sensitivity": "medium",
          "description": "Ngày xác minh KYC gần nhất."
        }
      ],
      "embedding_text_template": "Customer {customer_id} has KYC status {kyc_status}. The profile contains masked identity information and customer verification data.",
